{
  "name": "comfymui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "start": "node server.mjs",
    "test": "vitest run",
    "test:real": "vitest run --config vitest.real.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts/*.mjs server.mjs *.ts *.json index.html public/*.webmanifest"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource-variable/noto-sans-kr": "^5.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^5.1.0"
  }
}
