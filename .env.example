# ComfyMUI Docker Environment Configuration

# Local Windows models folder for reading models and optional downloads
# Examples:
#   Windows path: E:/Models
#   WSL path: /mnt/e/Models
HOST_MODELS_DIR=E:/Models

# ComfyUI listen port on the host
COMFY_PORT=8188

# Additional flags for ComfyUI execution
# Default is lowvram with 1GB headroom for RTX 4060 Ti (8GB)
COMFY_EXTRA_ARGS=--lowvram --reserve-vram 1

# ComfyMUI listen port on the host
PORT=4173
